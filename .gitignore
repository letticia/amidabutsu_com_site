# ==========================================================
#  天徳寺サイト (MkDocs + Material) / GitHub Pages 公開用
#  ここに書いたものは GitHub に上がりません。
#  公開に必要なのは docs/ , mkdocs.yml , .github/ の3つです。
# ==========================================================

# --- MkDocs のビルド成果物 -------------------------------
# `mkdocs build` / `mkdocs serve` が生成する HTML。
# GitHub Actions 側でビルドし直すのでコミット不要。
site/
.cache/

# --- 原稿・下書きなどの参照資料 ---------------------------
# 元原稿や未加工の写真など、公開しないもの置き場。
ref/

# --- macOS / Windows が勝手に作るファイル -----------------
.DS_Store
._*
.Spotlight-V100
.Trashes
.AppleDouble
Thumbs.db
Desktop.ini

# --- Python 仮想環境 --------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]

# --- エディタ / IDE の設定 --------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- 編集中・バックアップファイル -------------------------
*.bak
*.orig
*.tmp
~$*

# --- 秘密情報（誤コミット防止）----------------------------
.env
.env.*
*.pem
*.key
